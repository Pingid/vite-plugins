{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["DOM", "ESNext", "WebWorker"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": ["ts"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"]
  },
  "include": ["src", "vite.config.ts"]
}
